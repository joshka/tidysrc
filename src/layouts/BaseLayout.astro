---
type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = 'TidySrc is a pattern language for making source code easier to change.',
} = Astro.props;

const pageTitle = title === 'TidySrc' ? title : `${title} | TidySrc`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav class="nav shell" aria-label="Primary">
        <a class="brand" href="/">TidySrc</a>
        <div class="nav-links">
          <a href="/patterns/">Patterns</a>
          <a href="/concepts/">Concepts</a>
          <a href="/agents/">Agents</a>
          <a href="/configs/">Configs</a>
          <a href="/references/">References</a>
        </div>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <p>TidySrc names small, reviewable patterns for everyday source change.</p>
        <a href="/llms.txt">llms.txt</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --background: #fbfaf7;
    --surface: #ffffff;
    --surface-muted: #f4f2ed;
    --text: #1f2522;
    --muted: #616b66;
    --border: #dedbd2;
    --border-strong: #c9c4b8;
    --accent: #175f63;
    --accent-strong: #0d4448;
    --accent-soft: #e6f2f1;
    --warning-soft: #fff3d7;
    --stable-soft: #e8f4e7;
    --draft-soft: #edf0ff;
    --seed-soft: #f2eee8;
    --font-sans:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono:
      "SFMono-Regular", "SF Mono", Consolas, "Liberation Mono", Menlo, monospace;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.55;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.94em;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: 1rem;
    transform: translateY(-150%);
    background: var(--text);
    color: var(--surface);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .shell {
    width: min(1120px, calc(100% - 32px));
    margin-inline: auto;
  }

  .narrow {
    width: min(800px, calc(100% - 32px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 1rem;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1rem;
    font-size: 0.94rem;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .section {
    padding-block: 56px;
  }

  .section-tight {
    padding-block: 32px;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    line-height: 1.16;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 4rem);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }

  h3 {
    font-size: 1.15rem;
  }

  p {
    margin: 0 0 1rem;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 760px;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .panel,
  .pattern-row {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .panel {
    padding: 1rem;
  }

  .pattern-row {
    display: block;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .pattern-row:hover {
    border-color: var(--accent);
  }

  .meta-line,
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.12rem 0.55rem;
    color: var(--muted);
    background: var(--surface);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .status-stable {
    background: var(--stable-soft);
    color: #245a28;
  }

  .status-draft {
    background: var(--draft-soft);
    color: #303b79;
  }

  .status-seed {
    background: var(--seed-soft);
    color: #6c5843;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: white;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    padding-block: 24px;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .copy-box {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-muted);
    padding: 1rem;
  }

  .copy-box pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 2rem;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 0.45rem;
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .toc a {
    color: inherit;
    text-decoration: none;
  }

  .ec-line mark {
    background: rgba(255, 213, 102, 0.32);
  }

  @media (max-width: 820px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 0.75rem;
    }

    .nav-links {
      justify-content: flex-start;
    }

    .grid-3,
    .page-grid {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--border);
      padding: 1rem 0 0;
    }

    .footer-grid {
      flex-direction: column;
    }
  }
</style>
