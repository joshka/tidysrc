---
type Props = {
  title: string;
  description?: string;
};

const {
  title,
  description = 'TidySrc is a pattern language for making source code easier to change.',
} = Astro.props;

const pageTitle = title === 'TidySrc' ? title : `${title} | TidySrc`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Josh McKinney" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const storedMode = localStorage.getItem('tidysrc-theme-mode');
        const storedTheme = localStorage.getItem('tidysrc-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          storedMode === 'light' || storedMode === 'dark'
            ? storedMode
            : storedTheme === 'light' || storedTheme === 'dark'
              ? storedTheme
              : prefersDark
                ? 'dark'
                : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a class="brand" href="/">TIDYSRC</a>
        <div class="nav-links">
          <a href="/problems/">Problems</a>
          <a href="/patterns/">Patterns</a>
          <a href="/concepts/">Concepts</a>
          <a href="/agents/">Agents</a>
          <a href="/configs/">Configs</a>
          <a href="/references/">References</a>
        </div>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          data-theme-toggle
        >
          <span data-theme-label>System</span>
        </button>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p>
            TIDYSRC // patterns for everyday source change.
          </p>
          <p>
            Copyright © Josh McKinney. All rights reserved.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="https://www.joshka.net/">joshka.net</a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const themes = ['system', 'light', 'dark'] as const;

  function storedMode() {
    const mode = localStorage.getItem('tidysrc-theme-mode');
    return mode === 'light' || mode === 'dark' || mode === 'system' ? mode : 'system';
  }

  function resolvedTheme(mode: string) {
    return mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
  }

  function applyTheme(mode: string) {
    const theme = resolvedTheme(mode);
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    localStorage.setItem('tidysrc-theme-mode', mode);
    localStorage.setItem('tidysrc-theme', theme);
    if (themeLabel) {
      themeLabel.textContent = mode === 'system' ? `System ${theme}` : mode;
    }
  }

  themeButton?.addEventListener('click', () => {
    const mode = storedMode();
    const nextMode = themes[(themes.indexOf(mode) + 1) % themes.length];
    applyTheme(nextMode);
  });

  media.addEventListener('change', () => {
    if (storedMode() === 'system') {
      applyTheme('system');
    }
  });

  applyTheme(storedMode());
</script>

<style is:global>
  :root {
    --background: #f8f3ea;
    --surface: #fffaf1;
    --surface-muted: #eee4d5;
    --surface-strong: #17120c;
    --code-surface: #f0e5d4;
    --code-text: #181513;
    --strong-text: #ffffff;
    --strong-accent: #d97706;
    --text: #181513;
    --muted: #665642;
    --border: #2d2218;
    --border-strong: #181513;
    --accent: #d97706;
    --accent-text: #1b1004;
    --accent-strong: #7c4300;
    --accent-soft: #f7dfba;
    --warning-soft: #fff0c7;
    --stable-soft: #e4edd8;
    --stable-text: #334d1f;
    --draft-soft: #eee0c8;
    --draft-text: #68430c;
    --seed-soft: #eadfd1;
    --seed-text: #67523a;
    --grid-line: #eee4d5;
    --font-sans:
      "Space Grotesk", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    --font-mono:
      "SFMono-Regular", "SF Mono", Consolas, "Liberation Mono", Menlo, monospace;
  }

  :root[data-theme='dark'] {
    --background: #070908;
    --surface: #171a18;
    --surface-muted: #21241f;
    --surface-strong: #050606;
    --code-surface: #d6c8b4;
    --code-text: #17120c;
    --strong-text: #f2eee6;
    --strong-accent: #ffc174;
    --text: #e7e5df;
    --muted: #aa9b88;
    --border: #7a705f;
    --border-strong: #c8b8a1;
    --accent: #f59e0b;
    --accent-text: #2a1700;
    --accent-strong: #ffc174;
    --accent-soft: #281f12;
    --warning-soft: #261b0e;
    --stable-soft: #2a2412;
    --stable-text: #ffc174;
    --draft-soft: #242823;
    --draft-text: #d5d1c8;
    --seed-soft: #1d211f;
    --seed-text: #aa9b88;
    --grid-line: rgba(231, 229, 223, 0.04);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
      var(--background);
    background-size: 24px 24px;
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.55;
  }

  a {
    color: var(--accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.94em;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: 1rem;
    transform: translateY(-150%);
    background: var(--text);
    color: var(--surface);
    padding: 0.5rem 0.75rem;
    z-index: 10;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .shell {
    width: min(1200px, calc(100% - 32px));
    margin-inline: auto;
  }

  .narrow {
    width: min(800px, calc(100% - 32px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 2px solid var(--border);
    background: var(--surface);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    width: 100%;
  }

  .brand {
    align-self: stretch;
    display: flex;
    align-items: center;
    border-right: 2px solid var(--border);
    color: var(--text);
    font-weight: 800;
    letter-spacing: 0.12em;
    padding-inline: 24px;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-self: stretch;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    border-left: 2px solid var(--border);
    color: var(--text);
    padding-inline: 18px;
    text-decoration: none;
  }

  .nav-links a:hover {
    background: var(--accent);
    color: var(--accent-text);
  }

  .theme-toggle {
    align-self: stretch;
    border: 0;
    border-left: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding-inline: 18px;
    text-transform: uppercase;
  }

  .theme-toggle:hover {
    background: var(--accent);
    color: var(--accent-text);
  }

  .section {
    padding-block: 56px;
  }

  .section-tight {
    padding-block: 32px;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    line-height: 1.16;
    margin: 0 0 0.75rem;
    letter-spacing: -0.04em;
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 4rem);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }

  h3 {
    font-size: 1.15rem;
  }

  p {
    margin: 0 0 1rem;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 760px;
  }

  .page-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.45fr);
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .page-hero-main {
    display: grid;
    align-content: start;
    gap: 1rem;
    border-right: 2px solid var(--border);
    background: var(--surface-strong);
    color: var(--strong-text);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .page-hero-main .eyebrow,
  .page-hero-main .lede {
    color: var(--accent);
  }

  .page-hero-main h1 {
    color: var(--strong-text);
    margin: 0;
    text-transform: uppercase;
  }

  .page-hero-side {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .page-hero-side .lede {
    margin: 0;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .grid-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .panel,
  .pattern-row {
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface);
  }

  .panel {
    padding: 1rem;
  }

  .pattern-row {
    display: block;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .pattern-row:hover {
    background: var(--accent-soft);
    border-color: var(--border);
  }

  .meta-line,
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 0.12rem 0.55rem;
    color: var(--text);
    background: var(--surface);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-stable {
    background: var(--stable-soft);
    color: var(--stable-text);
  }

  .status-draft {
    background: var(--draft-soft);
    color: var(--draft-text);
  }

  .status-seed {
    background: var(--seed-soft);
    color: var(--seed-text);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border-strong);
    border-radius: 0;
    padding: 0.55rem 0.75rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .button.primary {
    border-color: var(--border);
    background: var(--accent);
    color: var(--accent-text);
  }

  .site-footer {
    border-top: 2px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    padding-block: 24px;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-grid p {
    margin: 0;
  }

  .footer-grid p + p {
    margin-top: 0.35rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    justify-content: flex-end;
  }

  .footer-links a {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .copy-box {
    display: grid;
    gap: 0.75rem;
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface-muted);
    padding: 1rem;
  }

  .copy-box pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 2rem;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 0.45rem;
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .toc a {
    color: inherit;
    text-decoration: none;
  }

  .ec-line mark {
    background: rgba(255, 213, 102, 0.32);
  }

  .expressive-code {
    --ec-brdRad: 0;
    --ec-brdWd: 2px;
    --ec-brdCol: var(--border);
    --ec-codeBg: var(--code-surface);
    --ec-codeFg: var(--code-text);
    --ec-codeFontFml: var(--font-mono);
    --ec-codeFontSize: 0.88rem;
    --ec-codeLineHt: 1.65;
    --ec-codePadBlk: 1rem;
    --ec-codePadInl: 1.15rem;
    --ec-focusBrd: var(--accent);
    --ec-sbThumbCol: color-mix(in srgb, var(--muted), transparent 60%);
    --ec-sbThumbHoverCol: var(--muted);
    --ec-frm-frameBoxShdCssVal: none;
    --ec-frm-edActTabBg: var(--code-surface);
    --ec-frm-edActTabFg: var(--code-text);
    --ec-frm-edActTabBrdCol: var(--border);
    --ec-frm-edActTabIndTopCol: var(--accent);
    --ec-frm-edActTabIndBtmCol: var(--code-surface);
    --ec-frm-edTabBrdRad: 0;
    --ec-frm-edTabBarBg: var(--surface-muted);
    --ec-frm-edTabBarBrdCol: var(--border);
    --ec-frm-edTabBarBrdBtmCol: var(--border);
    --ec-frm-edBg: var(--code-surface);
    --ec-frm-inlBtnFg: var(--code-text);
    --ec-frm-inlBtnBg: var(--code-text);
    --ec-frm-inlBtnBrd: var(--border);
    --ec-frm-tooltipSuccessBg: var(--accent);
    --ec-frm-tooltipSuccessFg: var(--accent-text);
  }

  .expressive-code .frame {
    border-radius: 0;
    color: var(--code-text);
  }

  .expressive-code pre,
  .expressive-code code {
    color: var(--code-text) !important;
  }

  .expressive-code .frame.has-title:not(.is-terminal) .title {
    border-radius: 0 !important;
    color: var(--code-text);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .expressive-code .copy button {
    border-radius: 0;
  }

  .expressive-code .ec-line span[style] {
    color: #0f0c09 !important;
    background-color: var(--0bg, transparent);
    font-style: var(--0fs, inherit);
    font-weight: var(--0fw, inherit);
    text-decoration: var(--0td, inherit);
  }

  .expressive-code .ec-line span[style*='#BF3441'] {
    color: #8f1d2b !important;
  }

  .expressive-code .ec-line span[style*='#6F42C1'] {
    color: #56319b !important;
  }

  .expressive-code .ec-line span[style*='#005CC5'] {
    color: #00477f !important;
  }

  .expressive-code .ec-line span[style*='#032F62'] {
    color: #07315f !important;
  }

  .expressive-code .ec-line span[style*='#AE4B07'] {
    color: #833600 !important;
  }

  .expressive-code .ec-line span[style*='#22863A'] {
    color: #17662d !important;
  }

  .expressive-code .ec-line span[style*='#6A737D'],
  .expressive-code .ec-line span[style*='#616972'] {
    color: #3f474d !important;
  }

  .expressive-code .ec-line span[style*='#24292E'] {
    color: #0f0c09 !important;
  }

  .expressive-code .ec-line span[style*='#1E7734'] {
    color: #0f5f25 !important;
  }

  @media (max-width: 820px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      padding-block: 0.75rem;
    }

    .brand {
      align-self: auto;
      border-right: 0;
      padding-inline: 16px;
    }

    .nav-links {
      justify-content: flex-start;
      padding-inline: 16px;
    }

    .nav-links a {
      border-left: 0;
      padding: 0.25rem 0.65rem 0.25rem 0;
    }

    .theme-toggle {
      align-self: auto;
      border-left: 0;
      margin-left: 16px;
      padding: 0.35rem 0.65rem;
    }

    .grid-3,
    .grid-4,
    .page-hero,
    .page-grid {
      grid-template-columns: 1fr;
    }

    .page-hero-main {
      border-right: 0;
      border-bottom: 2px solid var(--border);
    }

    .toc {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--border);
      padding: 1rem 0 0;
    }

    .footer-grid {
      flex-direction: column;
    }
  }
</style>
