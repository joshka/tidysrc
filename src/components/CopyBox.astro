---
type Props = {
  label?: string;
  text: string;
  resolveCurrentUrl?: boolean;
};

const { label, text, resolveCurrentUrl = false } = Astro.props;
---

<div class="copy-box" data-copy-box>
  {label ? <strong>{label}</strong> : null}
  <pre><code>{text}</code></pre>
  <div class="copy-box-actions">
    <button
      class="copy-icon-button"
      type="button"
      aria-label="Copy to clipboard"
      title="Copy to clipboard"
      data-copy-button
      data-copy-current-url={resolveCurrentUrl ? 'true' : undefined}
      data-copy-text={text}
    >
      <svg class="copy-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M8 7h10v13H8z" />
        <path d="M5 4h10v3" />
        <path d="M5 4v13h3" />
      </svg>
      <svg class="copied-icon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M9.4 16.6 4.8 12l1.4-1.4 3.2 3.2 8.4-8.4L19.2 7z" />
      </svg>
    </button>
  </div>
</div>

<script>
  const currentPageUrl = () => window.location.href.split('#')[0];
  const resolveCopyText = (text: string, button: HTMLButtonElement) =>
    button.dataset.copyCurrentUrl === 'true'
      ? text.replaceAll('__CURRENT_PAGE_URL__', currentPageUrl())
      : text;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-button]')) {
    const code = button.closest('[data-copy-box]')?.querySelector('code');
    if (code) {
      code.textContent = resolveCopyText(code.textContent ?? '', button);
    }

    button.addEventListener('click', async () => {
      const text = resolveCopyText(button.dataset.copyText ?? '', button);
      await navigator.clipboard.writeText(text);
      button.dataset.copied = 'true';
      button.setAttribute('aria-label', 'Copied to clipboard');
      button.title = 'Copied';
      window.setTimeout(() => {
        delete button.dataset.copied;
        button.setAttribute('aria-label', 'Copy to clipboard');
        button.title = 'Copy to clipboard';
      }, 1200);
    });
  }
</script>

<style>
  .copy-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    min-width: 0;
    position: relative;
  }

  .copy-box strong {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .copy-box pre {
    flex: 1;
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .copy-box code {
    overflow-wrap: anywhere;
    white-space: inherit;
  }

  .copy-box-actions {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    display: grid;
    place-items: center;
  }

  .copy-icon-button {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 3.2px;
    background: var(--code-surface);
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    transition:
      background 120ms ease,
      color 120ms ease,
      opacity 120ms ease;
  }

  .copy-box:hover .copy-icon-button,
  .copy-icon-button:focus-visible,
  .copy-icon-button[data-copied='true'] {
    opacity: 1;
  }

  .copy-icon-button:hover {
    background: var(--code-surface);
    color: var(--text);
  }

  .copy-icon-button svg {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.2rem;
    width: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.8;
  }

  .copy-icon-button .copied-icon {
    stroke-width: 2.2;
  }

  .copy-icon-button .copied-icon,
  .copy-icon-button[data-copied='true'] .copy-icon {
    display: none;
  }

  .copy-icon-button[data-copied='true'] .copied-icon {
    display: block;
  }
</style>
