---
type Props = {
  label: string;
  text: string;
  resolveCurrentUrl?: boolean;
};

const { label, text, resolveCurrentUrl = false } = Astro.props;
---

<div class="copy-box" data-copy-box>
  <div class="copy-box-header">
    <strong>{label}</strong>
    <button
      class="button"
      type="button"
      data-copy-button
      data-copy-current-url={resolveCurrentUrl ? 'true' : undefined}
      data-copy-text={text}
    >
      Copy
    </button>
  </div>
  <pre><code>{text}</code></pre>
</div>

<script>
  const currentPageUrl = () => window.location.href.split('#')[0];
  const resolveCopyText = (text: string, button: HTMLButtonElement) =>
    button.dataset.copyCurrentUrl === 'true'
      ? text.replaceAll('__CURRENT_PAGE_URL__', currentPageUrl())
      : text;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-button]')) {
    const code = button.closest('[data-copy-box]')?.querySelector('code');
    if (code) {
      code.textContent = resolveCopyText(code.textContent ?? '', button);
    }

    button.addEventListener('click', async () => {
      const text = resolveCopyText(button.dataset.copyText ?? '', button);
      await navigator.clipboard.writeText(text);
      const previous = button.textContent;
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = previous;
      }, 1200);
    });
  }
</script>

<style>
  .copy-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .copy-box strong {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.2;
  }

  .copy-box pre {
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    line-height: 1.55;
  }

  .copy-box .button {
    flex: none;
  }

  @media (max-width: 560px) {
    .copy-box-header {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
