---
type Props = {
  items: string[];
  labels?: Record<string, string>;
  links?: Record<string, string>;
  status?: string;
  statusHref?: string;
};

const { items, labels = {}, links = {}, status, statusHref } = Astro.props;
---

<div class="chip-list">
  {
    status &&
      (statusHref ? (
        <a class={`chip status-${status}`} href={statusHref}>
          {status}
        </a>
      ) : (
        <span class={`chip status-${status}`}>{status}</span>
      ))
  }
  {
    items.map((item) =>
      links[item] ? (
        <a class="chip" href={links[item]}>
          {labels[item] ?? item}
        </a>
      ) : (
        <span class="chip">{labels[item] ?? item}</span>
      ),
    )
  }
</div>
