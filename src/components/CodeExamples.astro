---
import { Code } from 'astro-expressive-code/components';

import { languageLabel, sortedLanguageCodes } from '../lib/catalog';

type Example = {
  title: string;
  path: string;
  language: string;
  code: string;
  note?: string;
};

type Props = {
  examples: Example[];
};

const { examples } = Astro.props;
const languages = sortedLanguageCodes([...new Set(examples.map((example) => example.language))]);
const hasTabs = languages.length > 1;
const exampleTone = (title: string) => {
  if (title.toLowerCase().startsWith('problem:')) {
    return 'problem';
  }
  if (title.toLowerCase().startsWith('better:')) {
    return 'better';
  }
  return undefined;
};
const exampleTitle = (title: string) => title.replace(/^(Problem|Better):\s+/i, '');
const tabId = `code-tabs-${examples
  .map((example) => `${example.language}-${example.title}`)
  .join('-')
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;
---

{
  hasTabs ? (
    <div class="code-tabs" data-code-tabs>
      <div class="code-tab-list" role="tablist" aria-label="Code language">
        {languages.map((language, index) => (
          <button
            aria-controls={`${tabId}-${language}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            class="code-tab"
            data-code-tab={language}
            id={`${tabId}-${language}-tab`}
            role="tab"
            type="button"
          >
            {languageLabel(language)}
          </button>
        ))}
      </div>
      {languages.map((language, index) => (
        <div
          aria-labelledby={`${tabId}-${language}-tab`}
          data-code-panel={language}
          hidden={index !== 0}
          id={`${tabId}-${language}`}
          role="tabpanel"
        >
          <div class="examples">
            {examples
              .filter((example) => example.language === language)
              .map((example) => {
                const tone = exampleTone(example.title);
                return (
                  <article class={`example ${tone ? `example-${tone}` : ''}`}>
                    <div class="example-header">
                      <div class="example-title">
                        {tone && <span class="example-tone">{tone}</span>}
                        <h3>{exampleTitle(example.title)}</h3>
                      </div>
                      <span>{example.path}</span>
                    </div>
                    {example.note && <p class="example-note">{example.note}</p>}
                    <Code code={example.code} lang={example.language} meta={`title="${example.path}"`} />
                  </article>
                );
              })}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="examples">
      {examples.map((example) => {
        const tone = exampleTone(example.title);
        return (
          <article class={`example ${tone ? `example-${tone}` : ''}`}>
            <div class="example-header">
              <div class="example-title">
                {tone && <span class="example-tone">{tone}</span>}
                <h3>{exampleTitle(example.title)}</h3>
              </div>
              <span>{example.path}</span>
            </div>
            {example.note && <p class="example-note">{example.note}</p>}
            <Code code={example.code} lang={example.language} meta={`title="${example.path}"`} />
          </article>
        );
      })}
    </div>
  )
}

<script>
  for (const tabs of document.querySelectorAll<HTMLElement>('[data-code-tabs]')) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[data-code-tab]')];
    const panels = [...tabs.querySelectorAll<HTMLElement>('[data-code-panel]')];

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const language = button.dataset.codeTab;
        for (const candidate of buttons) {
          candidate.setAttribute('aria-selected', String(candidate === button));
        }
        for (const panel of panels) {
          panel.hidden = panel.dataset.codePanel !== language;
        }
      });
    }
  }
</script>

<style is:global>
  .code-tabs {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .code-tab-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .code-tab {
    appearance: none;
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.45rem 0.7rem;
    text-transform: uppercase;
  }

  .code-tab[aria-selected='true'] {
    background: var(--accent);
    color: var(--accent-text);
  }

  [role='tabpanel'] {
    min-width: 0;
  }

  .examples {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .example {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    border-left: 4px solid transparent;
    padding-left: 0.75rem;
  }

  .example-problem {
    border-left-color: #b42318;
  }

  .example-better {
    border-left-color: #2f6f3e;
  }

  .example-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.5rem;
  }

  .example-header h3 {
    margin: 0;
    min-width: 0;
  }

  .example-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .example-tone {
    border: 2px solid currentColor;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    padding: 0.25rem 0.35rem;
    text-transform: uppercase;
  }

  .example-problem .example-tone {
    background: #b42318;
    border-color: #b42318;
    color: #fffaf1;
  }

  .example-better .example-tone {
    background: #2f6f3e;
    border-color: #2f6f3e;
    color: #fffaf1;
  }

  .example-header span {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    overflow-wrap: anywhere;
    text-align: right;
  }

  .example-note {
    border: 2px solid var(--border);
    background: var(--surface-muted);
    margin: 0;
    padding: 0.75rem;
  }

  .example .expressive-code {
    max-width: 100%;
    min-width: 0;
  }

  .example .expressive-code figure.frame {
    max-width: 100%;
  }

  .example .expressive-code pre {
    font-size: 0.94rem;
    font-weight: 500;
    max-width: 100%;
    overflow-x: hidden;
  }

  .example .expressive-code .ec-line,
  .example .expressive-code .code {
    inline-size: auto;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  @media (max-width: 700px) {
    .example-header {
      grid-template-columns: 1fr;
    }

    .example-header span {
      text-align: left;
    }
  }
</style>
