---
import { parseInlineMarkdown } from '../lib/problemContent';
import { sitePath } from '../lib/site';

type Props = {
  text: string;
};

const { text } = Astro.props;
const parts = parseInlineMarkdown(text);
const hrefFor = (href: string) => (href.startsWith('/') ? sitePath(href) : href);
---

{
  parts.map((part) => {
    switch (part.type) {
      case 'link':
        return <a href={hrefFor(part.href)}>{part.text}</a>;
      case 'code':
        return <code>{part.text}</code>;
      case 'strong':
        return <strong>{part.text}</strong>;
      case 'emphasis':
        return <em>{part.text}</em>;
      default:
        return part.text;
    }
  })
}
