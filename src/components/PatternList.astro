---
import type { PatternEntry } from '../lib/catalog';
import {
  languageLabel,
  patternHref,
  patternSearchText,
  sortedLanguageCodes,
  sortedPatterns,
} from '../lib/catalog';
import Chips from './Chips.astro';

type Props = {
  patterns: PatternEntry[];
};

const { patterns } = Astro.props;
const sorted = sortedPatterns(patterns);
---

<div class="catalog-list" data-catalog-list>
  {
    sorted.map((pattern) => (
      <a
        class="pattern-row"
        href={patternHref(pattern)}
        data-pattern-row
        data-search={patternSearchText(pattern)}
        data-tags={pattern.data.tags.join(' ')}
        data-status={pattern.data.status}
        data-languages={pattern.data.languages.join(' ')}
        data-audiences={pattern.data.audiences.join(' ')}
      >
        <div class="row-head">
          <h2>{pattern.data.title}</h2>
          <Chips items={pattern.data.tags.slice(0, 4)} status={pattern.data.status} />
        </div>
        <p>{pattern.data.summary}</p>
        <div class="meta-line">
          {pattern.data.audiences.map((audience) => <span class="chip">{audience}</span>)}
          {sortedLanguageCodes(pattern.data.languages).map((language) => (
            <span class="chip">{languageLabel(language)}</span>
          ))}
        </div>
        <div class="row-actions">
          <span class="read-docs">Open</span>
        </div>
      </a>
    ))
  }
  <p class="empty-state" data-empty-state hidden>No patterns match the current filters.</p>
</div>

<style>
  .catalog-list {
    display: grid;
    gap: 0.75rem;
  }

  .pattern-row {
    display: grid;
    gap: 0.85rem;
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .row-head h2 {
    font-size: 1.1rem;
    text-transform: uppercase;
  }

  .pattern-row p {
    color: var(--muted);
  }

  .row-actions {
    display: block;
  }

  .read-docs {
    display: flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    border: 2px solid var(--border-strong);
    margin-left: auto;
    padding: 0.42rem 0.6rem;
    background: var(--surface);
    color: var(--text);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pattern-row:hover .read-docs,
  .pattern-row:focus-visible .read-docs {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-text);
  }

  .empty-state {
    border: 1px dashed var(--border-strong);
    border-radius: 8px;
    padding: 1.5rem;
    color: var(--muted);
  }
</style>
