---
import { Code } from 'astro-expressive-code/components';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { clippyToml, markdownlintYaml, rustfmtToml } from '../../data/catalog';

const denyToml = `[licenses]
version = 2
confidence-threshold = 0.8
allow = [
  "Apache-2.0",
  "BSD-2-Clause",
  "BSD-3-Clause",
  "ISC",
  "MIT",
  "Unicode-3.0",
  "Unicode-DFS-2016",
  "Zlib",
]

[advisories]
version = 2

[bans]
multiple-versions = "allow"

[sources]
unknown-registry = "deny"
unknown-git = "warn"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]`;
const agentHandoff = `Goal:
- <name the behavior or source shape to change>

Allowed edits:
- <file or directory>

Out of scope:
- <nearby cleanup that should not happen>
- <public contracts that must not change>

Stop and ask if:
- the edit surface grows
- tests pass only after weakening assertions
- generated or user-owned files need changes

Verification:
- <command that proves the changed behavior>`;
const verificationHandoff = `Verification run:
- <command>: passed

Not run:
- <check that still needs a person or environment>

Remaining risk:
- <specific behavior, browser state, or integration not covered>`;
const repoLocalInstruction = `Follow this repository's instructions first.

When the repository is silent, prefer small source changes that reduce reader burden, protect
observable behavior, avoid premature architecture, and report only verification that actually ran.`;
---

<BaseLayout title="Configs" description="Reusable TidySrc config defaults.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Configs</p>
        <h1>Reusable defaults that match the pattern language.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          These examples encode review-friendly defaults. Copy them when the project has no local
          rule, and preserve repo-local conventions when they are deliberate.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell config-stack">
    <article class="config-card">
      <h2>rustfmt.toml</h2>
      <p>
        Rust formatting defaults favor 2024 edition syntax, shorthand initialization, readable
        comments, organized imports, and formatter-owned consistency.
      </p>
      <Code code={rustfmtToml} lang="toml" meta={'title="rustfmt.toml"'} />
    </article>

    <article class="config-card">
      <h2>clippy.toml</h2>
      <p>
        This setting avoids treating exported API compatibility as a blanket blocker for local
        maintainability work. Public crates should still evaluate API impact deliberately.
      </p>
      <Code code={clippyToml} lang="toml" meta={'title="clippy.toml"'} />
    </article>

    <article class="config-card">
      <h2>deny.toml</h2>
      <p>
        This license and source policy blocks unknown registries, allows common permissive
        licenses, and leaves version duplication to project review. Projects with stricter legal
        requirements should replace the allow list.
      </p>
      <Code code={denyToml} lang="toml" meta={'title="deny.toml"'} />
    </article>

    <article class="config-card">
      <h2>markdownlint-cli2.yaml</h2>
      <p>
        Documentation should be readable in review diffs. The default prose width is 100
        characters, with tables exempted so they can remain aligned.
      </p>
      <Code code={markdownlintYaml} lang="yaml" meta={'title=".markdownlint-cli2.yaml"'} />
    </article>

    <article class="config-card">
      <h2>agent-handoff.md</h2>
      <p>
        Use this shape when an agent or teammate needs a bounded task. It names the edit surface,
        stop conditions, and verification before work starts.
      </p>
      <Code code={agentHandoff} lang="md" meta={'title="agent-handoff.md"'} />
    </article>

    <article class="config-card">
      <h2>verification-handoff.md</h2>
      <p>
        Use this after a change so the next reader can distinguish checks that ran from checks that
        are still recommendations.
      </p>
      <Code code={verificationHandoff} lang="md" meta={'title="verification-handoff.md"'} />
    </article>

    <article class="config-card">
      <h2>repo-local-agent-rule.md</h2>
      <p>
        Use this as a small AGENTS.md-style baseline when a repository has no stronger local
        instructions yet.
      </p>
      <Code code={repoLocalInstruction} lang="md" meta={'title="repo-local-agent-rule.md"'} />
    </article>
  </section>
</BaseLayout>

<style>
  .config-stack {
    display: grid;
    gap: 1rem;
  }

  .config-card {
    border: 2px solid var(--border);
    background: var(--surface);
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .config-card h2 {
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
    text-transform: uppercase;
  }
</style>
