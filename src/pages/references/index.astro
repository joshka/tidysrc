---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { references } from '../../data/catalog';

const slug = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<BaseLayout title="References" description="Influences and adjacent sources for TidySrc.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">References</p>
        <h1>Influences, not authorities.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          TidySrc borrows from refactoring catalogs, pattern languages, legacy-code practice, UX
          heuristics, and design discussions. The catalog treats them as context, not as a rule
          hierarchy.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell grid">
    {
      references.map((reference) => (
        <a class="panel reference" href={reference.href} id={slug(reference.title)}>
          <h2>{reference.title}</h2>
          <p>{reference.note}</p>
          <span>{reference.href}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .reference {
    display: grid;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  .reference h2 {
    font-size: 1.1rem;
  }

  .reference p,
  .reference span {
    color: var(--muted);
  }

  .reference span {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
</style>
