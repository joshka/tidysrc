---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const references = await getCollection('references');
const referenceById = new Map(references.map((reference) => [reference.id, reference]));
const referenceGroups = [
  {
    title: 'Refactoring Catalogs',
    summary:
      'Durable refactoring names, before-after mechanics, and code-smell vocabulary for precise review comments.',
    references: ['refactoring-com', 'refactoring-com-catalog', 'refactoring-guru-catalog'],
  },
  {
    title: 'Pattern Sources',
    summary:
      'Catalog structure, naming discipline, and the older pattern-language tradition behind compact linked entries.',
    references: [
      'portland-pattern-repository',
      'hillside-patterns',
      'architectural-metapatterns',
    ],
  },
  {
    title: 'Legacy-Code Practice',
    summary:
      'Characterization, seams, incremental change tactics, and maintenance-shaped examples.',
    references: [
      'working-effectively-with-legacy-code',
      'understand-legacy-code-articles',
      'sourcemaking-code-smells',
    ],
  },
  {
    title: 'Source-Change Economics',
    summary:
      'Small tidying moves, reversibility, cohesion, coupling, and reviewable change batch size.',
    references: ['tidy-first', 'geepaw-large-scale-refactoring', 'laws-of-software-engineering'],
  },
  {
    title: 'Rust API Design',
    summary:
      'Rust-specific checklists for public API shape, naming, type safety, documentation, ergonomics, and reviewable crate boundaries.',
    references: [
      'ed-page-s-rust-style',
      'rust-api-guidelines-checklist',
      'microsoft-pragmatic-rust-checklist',
    ],
  },
  {
    title: 'Interfaces and User Burden',
    summary:
      'API shape, interface refactoring, reader burden, and human-centered heuristics.',
    references: ['patterns-dev', 'interface-refactoring-catalog', 'laws-of-ux'],
  },
  {
    title: 'Agent Tooling and Failure Modes',
    summary:
      'Agent workflow, context hygiene, stop conditions, and verification expectations around AI-assisted edits.',
    references: ['ai-blindspots', 'agentpatterns-ai'],
  },
];
---

<BaseLayout title="References" description="Influences and adjacent sources for TidySrc.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">References</p>
        <h1>Sources behind TidySrc</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Refactoring catalogs, pattern-language history, legacy-code practice, UX heuristics, and
          agent-tooling notes provide names, examples, and tradeoffs for source-change discussions.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell reference-groups">
    {
      referenceGroups.map((group) => (
        <section class="panel reference-group">
          <div class="reference-group-head">
            <div class="reference-group-title">
              <p class="eyebrow">Reference group</p>
              <h2>{group.title}</h2>
            </div>
            <p>{group.summary}</p>
          </div>
          <div class="reference-grid">
            {group.references.map((id) => {
              const reference = referenceById.get(id);
              return reference ? (
                <article class="reference" id={reference.id}>
                  <h3>
                    <a href={reference.data.href}>{reference.data.title}</a>
                  </h3>
                  <p>{reference.body}</p>
                  <a class="reference-url" href={reference.data.href}>{reference.data.href}</a>
                </article>
              ) : null;
            })}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .reference-groups {
    display: grid;
    gap: 1rem;
  }

  .reference-group {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .reference-group-head {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: 1rem;
    border-bottom: 2px solid var(--border);
    background: var(--surface-muted);
    min-height: 118px;
    padding: 1.25rem 1rem;
  }

  .reference-group-title {
    display: grid;
    gap: 0.6rem;
  }

  .reference-group-head .eyebrow,
  .reference-group-head h2 {
    margin: 0;
  }

  .reference-group-head h2 {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .reference-group-head p:last-child {
    align-self: center;
    color: var(--muted);
    margin: 0;
    padding-top: 0.8rem;
  }

  .reference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .reference {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    min-height: 190px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    padding: 1rem;
    color: inherit;
  }

  .reference h3 {
    font-size: 1.1rem;
  }

  .reference h3 a {
    color: inherit;
    text-decoration: none;
  }

  .reference h3 a:hover {
    color: var(--accent-strong);
  }

  .reference p,
  .reference-url {
    color: var(--muted);
  }

  .reference-url {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  @media (max-width: 900px) {
    .reference-group-head,
    .reference-grid {
      grid-template-columns: 1fr;
    }

    .reference {
      border-right: 0;
      min-height: auto;
    }
  }
</style>
