---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const references = await getCollection('references');
const sortedReferences = references.sort((left, right) =>
  left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout title="References" description="Influences and adjacent sources for TidySrc.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">References</p>
        <h1>Influences, not authorities.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          TidySrc borrows from refactoring catalogs, pattern languages, legacy-code practice, UX
          heuristics, and design discussions. The catalog treats them as context, not as a rule
          hierarchy.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell grid">
    {
      sortedReferences.map((reference) => (
        <article class="panel reference" id={reference.id}>
          <h2>
            <a href={reference.data.href}>{reference.data.title}</a>
          </h2>
          <p>{reference.body}</p>
          <a class="reference-url" href={reference.data.href}>{reference.data.href}</a>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .reference {
    display: grid;
    gap: 0.35rem;
    color: inherit;
  }

  .reference h2 {
    font-size: 1.1rem;
  }

  .reference h2 a {
    color: inherit;
    text-decoration: none;
  }

  .reference h2 a:hover {
    color: var(--accent-strong);
  }

  .reference p,
  .reference-url {
    color: var(--muted);
  }

  .reference-url {
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }
</style>
