---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  allProblemCategories,
  type PatternEntry,
  patternHref,
  problemHref,
  problemCategoryLabel,
  problemSearchText,
  sortedProblems,
} from '../../lib/catalog';
import { parseProblemContent } from '../../lib/problemContent';

const problems = sortedProblems(await getCollection('problems'));
const categories = allProblemCategories(problems);
const patterns = await getCollection('patterns');
const patternById = new Map(patterns.map((pattern) => [pattern.id, pattern]));
const isPatternEntry = (pattern: PatternEntry | undefined): pattern is PatternEntry =>
  pattern !== undefined;
const selectedQuery = Astro.url.searchParams.get('q')?.trim() ?? '';
const selectedQueryLower = selectedQuery.toLowerCase();
const selectedStatus = Astro.url.searchParams.get('status') ?? '';
const selectedCategory = Astro.url.searchParams.get('category') ?? '';
const problemPathways = [
  {
    title: 'Reading and Review Friction',
    category: 'readability',
    summary:
      'The code technically works, but the main path, name, or reason for the change is hard to find.',
  },
  {
    title: 'Tests and Evidence',
    category: 'testing',
    summary:
      'The risk sits in the proof: brittle assertions, private-shape tests, flakes, or checks that miss the behavior users rely on.',
  },
  {
    title: 'Boundaries and Contracts',
    category: 'boundaries',
    summary:
      'Raw input, foreign vocabulary, specifications, or validation rules cross layers without a clear owner.',
  },
  {
    title: 'State, Effects, and Time',
    category: 'state',
    summary:
      'Flags, transitions, caches, async ownership, mutation, or side effects make future behavior hard to predict.',
  },
  {
    title: 'Change Risk',
    category: 'change-risk',
    summary:
      'The risk comes from the shape of the change: blast radius, mixed intent, migration order, or reversibility.',
  },
  {
    title: 'Architecture Pressure',
    category: 'architecture',
    summary:
      'A local change starts carrying broader design concepts before the repeated pressure justifies them.',
  },
  {
    title: 'Workflow Drift',
    category: 'agent-workflow',
    summary:
      'The work keeps moving after its constraints, evidence, or done signal have gone stale. Agent-written changes can make the same drift look more confident and complete.',
  },
];
const categoryLabels = Object.fromEntries(
  categories.map((category) => [category, problemCategoryLabel(category)]),
);
const categoryCounts = new Map(
  categories.map((category) => [
    category,
    problems.filter((problem) => problem.data.category === category).length,
  ]),
);
const initialVisibility = new Map(
  problems.map((problem) => {
    const matchesQuery =
      selectedQueryLower.length === 0 || problemSearchText(problem).includes(selectedQueryLower);
    const matchesStatus = selectedStatus.length === 0 || problem.data.status === selectedStatus;
    const matchesCategory =
      selectedCategory.length === 0 || problem.data.category === selectedCategory;

    return [problem.id, matchesQuery && matchesStatus && matchesCategory];
  }),
);
const visibleProblemCount = [...initialVisibility.values()].filter(Boolean).length;
---

<BaseLayout
  title="Problems"
  description="Diagnose source-change problems and choose the TidySrc patterns that fit."
>
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Problem index</p>
        <h1>Name the source-change problem.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Vague concerns such as “this feels risky” or “this is hard to read” become easier to act
          on when the underlying source-change problem has a name.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell">
    <div class="pathway-head">
      <p class="eyebrow">Problem pathways</p>
      <h2>Diagnose the pressure on the next change.</h2>
      <p>
        Categories group recurring pressures in source changes: reading friction, weak evidence,
        leaky boundaries, hidden state, change risk, and workflow drift.
      </p>
    </div>
    <div class="pathway-grid" role="tablist" aria-label="Problem pathways">
      {
        problemPathways.map((pathway) => (
          <button
            class="pathway-card"
            type="button"
            data-problem-category-tab={pathway.category}
          >
            <span>{categoryCounts.get(pathway.category) ?? 0} problems</span>
            <strong>{pathway.title}</strong>
            <small>{pathway.summary}</small>
          </button>
        ))
      }
    </div>
  </section>

  <section class="section-tight shell problems-layout">
    <aside class="panel filters" aria-label="Problem filters">
      <label>
        Search
        <input
          data-problem-search
          type="search"
          placeholder="legacy, validation, agents, tests"
          value={selectedQuery}
        />
      </label>
      <div class="filter-note">
        Search for the symptom, the affected code shape, or the pattern you expect to apply.
      </div>
      <label>
        Status
        <select data-problem-status>
          <option value="" selected={selectedStatus === ''}>Any status</option>
          <option value="reviewed" selected={selectedStatus === 'reviewed'}>Reviewed</option>
          <option value="draft" selected={selectedStatus === 'draft'}>Draft</option>
          <option value="seed" selected={selectedStatus === 'seed'}>Seed</option>
        </select>
      </label>
      <label>
        Category
        <select data-problem-category>
          <option value="" selected={selectedCategory === ''}>Any category</option>
          {
            categories.map((category) => (
              <option value={category} selected={selectedCategory === category}>
                {problemCategoryLabel(category)}
              </option>
            ))
          }
        </select>
      </label>
    </aside>

    <div class="problem-list" data-problem-list>
      {
        problems.map((problem) => {
          const problemContent = parseProblemContent(problem.body ?? '', problem.id);
          const cardChips = [problem.data.category, ...problem.data.topics.slice(0, 2)];
          const chipLinks = Object.fromEntries([
            [problem.data.category, `/problems/?category=${encodeURIComponent(problem.data.category)}`],
            ...problem.data.topics.slice(0, 2).map((topic) => [
              topic,
              `/problems/?q=${encodeURIComponent(topic)}`,
            ]),
          ]);
          const relatedPatterns = problem.data.relatedPatterns
            .map((id) => patternById.get(id))
            .filter(isPatternEntry)
            .slice(0, 4);

          return (
            <article
              class="panel problem-card"
              data-problem-card
              data-search={problemSearchText(problem)}
              data-status={problem.data.status}
              data-category={problem.data.category}
              hidden={!initialVisibility.get(problem.id)}
            >
              <div class="problem-card-main">
                <div>
                  <p class="eyebrow">Problem</p>
                  <h2>
                    <a href={problemHref(problem)}>{problem.data.title}</a>
                  </h2>
                  <Chips
                    items={cardChips}
                    labels={categoryLabels}
                    links={chipLinks}
                    status={problem.data.status}
                    statusHref={`/problems/?status=${encodeURIComponent(problem.data.status)}`}
                  />
                </div>
                <p>{problem.data.summary}</p>
                <div class="impact-preview">
                  <strong>Why it matters</strong>
                  <span>{problemContent.impact}</span>
                </div>
                <div class="signal-strip" aria-label="Common signals">
                  {problemContent.signals.slice(0, 2).map((signal) => (
                    <span>{signal}</span>
                  ))}
                </div>
              </div>
              <div class="problem-card-side">
                <h3>Related patterns</h3>
                <div class="related-links">
                  {relatedPatterns.map((pattern) => (
                    <a href={patternHref(pattern)}>{pattern?.data.title}</a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
      <p class="empty-state" data-empty-state hidden={visibleProblemCount > 0}>
        No problems match the current search.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-problem-search]');
  const status = document.querySelector<HTMLSelectElement>('[data-problem-status]');
  const category = document.querySelector<HTMLSelectElement>('[data-problem-category]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-problem-card]'));
  const categoryTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-problem-category-tab]'),
  );
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);

  if (search && params.has('q')) {
    search.value = params.get('q') ?? '';
  }

  if (status && params.has('status')) {
    status.value = params.get('status') ?? '';
  }

  if (category && params.has('category')) {
    category.value = params.get('category') ?? '';
  }

  function updateUrl() {
    const next = new URLSearchParams();
    const query = search?.value.trim() ?? '';
    if (query) {
      next.set('q', query);
    }
    if (status?.value) {
      next.set('status', status.value);
    }
    if (category?.value) {
      next.set('category', category.value);
    }

    const queryString = next.toString();
    const url = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    window.history.replaceState(null, '', url);
  }

  function applySearch() {
    const query = search?.value.trim().toLowerCase() ?? '';
    const statusValue = status?.value ?? '';
    const categoryValue = category?.value ?? '';
    let visible = 0;

    for (const card of cards) {
      const matchesQuery = !query || card.dataset.search?.includes(query);
      const matchesStatus = !statusValue || card.dataset.status === statusValue;
      const matchesCategory = !categoryValue || card.dataset.category === categoryValue;
      const show = Boolean(matchesQuery && matchesStatus && matchesCategory);
      card.hidden = !show;
      if (show) {
        visible += 1;
      }
    }

    if (empty) {
      empty.hidden = visible > 0;
    }

    updateUrl();
  }

  search?.addEventListener('input', applySearch);
  status?.addEventListener('change', applySearch);
  category?.addEventListener('change', applySearch);
  for (const categoryTab of categoryTabs) {
    categoryTab.addEventListener('click', () => {
      const value = categoryTab.dataset.problemCategoryTab ?? '';
      if (category) {
        category.value = category.value === value ? '' : value;
      }
      applySearch();
    });
  }
  applySearch();
</script>

<style>
  .pathway-head {
    display: grid;
    gap: 0.5rem;
    max-width: 920px;
    margin-bottom: 1rem;
  }

  .pathway-head h2 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    text-transform: uppercase;
  }

  .pathway-head p:last-child {
    color: var(--muted);
  }

  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pathway-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    padding: 1.15rem;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pathway-card:hover,
  .pathway-card:focus-visible {
    background: var(--accent-soft);
    border-color: var(--border-strong);
  }

  .pathway-card span {
    width: max-content;
    border: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 0.2rem 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pathway-card strong {
    display: block;
    font-size: 1.08rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .pathway-card small {
    display: block;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .problems-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .filters {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 0.8rem;
  }

  .filters label {
    display: grid;
    gap: 0.35rem;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filters input,
  .filters select {
    width: 100%;
    border: 2px solid var(--border-strong);
    border-radius: 0;
    padding: 0.55rem 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .filter-note {
    border-top: 2px solid var(--border);
    padding-top: 0.8rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .problem-list {
    display: grid;
    gap: 1rem;
  }

  .problem-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.36fr);
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .problem-card-main,
  .problem-card-side {
    padding: 1rem;
  }

  .problem-card-main {
    display: grid;
    gap: 0.8rem;
  }

  .problem-card-main h2 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    text-transform: uppercase;
  }

  .problem-card-main h2 a {
    color: inherit;
    text-decoration: none;
  }

  .problem-card-main p {
    color: var(--muted);
  }

  .impact-preview {
    display: grid;
    gap: 0.35rem;
    border: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 0.75rem;
  }

  .impact-preview strong {
    color: var(--text);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .impact-preview span {
    color: var(--muted);
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--border);
    gap: 0;
  }

  .signal-strip span {
    padding: 0.75rem 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .signal-strip span + span {
    border-left: 2px solid var(--border);
    padding-left: 0.75rem;
  }

  .problem-card-side {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    border-left: 2px solid var(--border);
    background: var(--surface-muted);
  }

  .problem-card-side h3 {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-links {
    display: grid;
    gap: 0.45rem;
  }

  .related-links a {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0.45rem 0.55rem;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .related-links a:hover {
    background: var(--accent);
    color: var(--accent-text);
  }

  .empty-state {
    border: 2px dashed var(--border);
    padding: 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .pathway-grid,
    .problems-layout,
    .problem-card,
    .signal-strip {
      grid-template-columns: 1fr;
    }

    .filters {
      position: static;
    }

    .problem-card-side,
    .signal-strip span + span {
      border-left: 0;
    }

    .problem-card-side {
      border-top: 2px solid var(--border);
    }

    .signal-strip span + span {
      padding-left: 0;
    }
  }
</style>
