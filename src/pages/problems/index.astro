---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  type PatternEntry,
  patternHref,
  problemHref,
  problemSearchText,
  sortedProblems,
} from '../../lib/catalog';

const problems = sortedProblems(await getCollection('problems'));
const patterns = await getCollection('patterns');
const patternById = new Map(patterns.map((pattern) => [pattern.id, pattern]));
const isPatternEntry = (pattern: PatternEntry | undefined): pattern is PatternEntry =>
  pattern !== undefined;
---

<BaseLayout
  title="Problems"
  description="Diagnose source-change problems and choose the TidySrc patterns that fit."
>
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Problem index</p>
        <h1>Start from the source-change problem you are actually seeing.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Problems connect review symptoms to patterns. A vague concern such as “this feels risky”
          or “this is hard to read” can become a concrete refactoring move.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell problems-layout">
    <aside class="panel filters" aria-label="Problem filters">
      <label>
        Search
        <input
          data-problem-search
          type="search"
          placeholder="legacy, validation, agents, tests"
        />
      </label>
      <div class="filter-note">
        Search reads titles, symptoms, diagnostic questions, approaches, and related pattern ids.
      </div>
    </aside>

    <div class="problem-list" data-problem-list>
      {
        problems.map((problem) => {
          const relatedPatterns = problem.data.relatedPatterns
            .map((id) => patternById.get(id))
            .filter(isPatternEntry)
            .slice(0, 4);

          return (
            <article
              class="panel problem-card"
              data-problem-card
              data-search={problemSearchText(problem)}
            >
              <div class="problem-card-main">
                <div>
                  <p class="eyebrow">Problem</p>
                  <h2>
                    <a href={problemHref(problem)}>{problem.data.title}</a>
                  </h2>
                </div>
                <p>{problem.data.summary}</p>
                <div class="signal-strip" aria-label="Common signals">
                  {problem.data.signals.slice(0, 2).map((signal) => (
                    <span>{signal}</span>
                  ))}
                </div>
              </div>
              <div class="problem-card-side">
                <h3>Related patterns</h3>
                <div class="related-links">
                  {relatedPatterns.map((pattern) => (
                    <a href={patternHref(pattern)}>{pattern?.data.title}</a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
      <p class="empty-state" data-empty-state hidden>No problems match the current search.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-problem-search]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-problem-card]'));
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');

  function applySearch() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;

    for (const card of cards) {
      const show = !query || card.dataset.search?.includes(query);
      card.hidden = !show;
      if (show) {
        visible += 1;
      }
    }

    if (empty) {
      empty.hidden = visible > 0;
    }
  }

  search?.addEventListener('input', applySearch);
  applySearch();
</script>

<style>
  .problems-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .filters {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 0.8rem;
  }

  .filters label {
    display: grid;
    gap: 0.35rem;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filters input {
    width: 100%;
    border: 2px solid var(--border-strong);
    border-radius: 0;
    padding: 0.55rem 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .filter-note {
    border-top: 2px solid var(--border);
    padding-top: 0.8rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .problem-list {
    display: grid;
    gap: 1rem;
  }

  .problem-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.36fr);
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .problem-card-main,
  .problem-card-side {
    padding: 1rem;
  }

  .problem-card-main {
    display: grid;
    gap: 0.8rem;
  }

  .problem-card-main h2 {
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    text-transform: uppercase;
  }

  .problem-card-main h2 a {
    color: inherit;
    text-decoration: none;
  }

  .problem-card-main p {
    color: var(--muted);
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--border);
    gap: 0;
  }

  .signal-strip span {
    padding: 0.75rem 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .signal-strip span + span {
    border-left: 2px solid var(--border);
    padding-left: 0.75rem;
  }

  .problem-card-side {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    border-left: 2px solid var(--border);
    background: var(--surface-muted);
  }

  .problem-card-side h3 {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-links {
    display: grid;
    gap: 0.45rem;
  }

  .related-links a {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0.45rem 0.55rem;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .related-links a:hover {
    background: var(--accent);
    color: var(--accent-text);
  }

  .empty-state {
    border: 2px dashed var(--border);
    padding: 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .problems-layout,
    .problem-card,
    .signal-strip {
      grid-template-columns: 1fr;
    }

    .filters {
      position: static;
    }

    .problem-card-side,
    .signal-strip span + span {
      border-left: 0;
    }

    .problem-card-side {
      border-top: 2px solid var(--border);
    }

    .signal-strip span + span {
      padding-left: 0;
    }
  }
</style>
