---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import CodeExamples from '../../components/CodeExamples.astro';
import InlineMarkdown from '../../components/InlineMarkdown.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { patternHref } from '../../lib/catalog';
import { parseConceptContent } from '../../lib/conceptContent';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((concept) => ({ params: { id: concept.id }, props: { concept } }));
}

const { concept } = Astro.props;
const conceptContent = parseConceptContent(concept.body ?? '', concept.id);
const patterns = await getCollection('patterns');
const patternById = new Map(patterns.map((entry) => [entry.id, entry]));
const conceptMetrics = ['Cognitive load', 'Review time', 'Change radius'];
---

<BaseLayout title={concept.data.title} description={concept.data.summary}>
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Concept // {concept.id}</p>
        <h1>{concept.data.title}</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">{concept.data.summary}</p>
        <Chips items={concept.data.tags} status={concept.data.status} />
      </div>
    </div>
  </section>

  <section class="section-tight shell concept-layout">
    <article class="concept-sheet">
      <div class="concept-narrative">
        {
          conceptContent.sections.map((section, index) => (
            <section
              class:list={['concept-card', { muted: index % 2 === 1 }]}
              id={section.title.toLowerCase().replaceAll(' ', '-')}
            >
              <p class="eyebrow">Concept block {String(index + 1).padStart(2, '0')}</p>
              <h2>{section.title}</h2>
              {section.body.map((paragraph) => <p><InlineMarkdown text={paragraph} /></p>)}
            </section>
          ))
        }

        {
          conceptContent.examples && conceptContent.examples.length > 0 && (
            <section class="concept-card example-card" id="examples">
              <p class="eyebrow">Examples</p>
              <h2>How it shows up in code</h2>
              <CodeExamples examples={conceptContent.examples} />
            </section>
          )
        }
      </div>

      <aside class="concept-sidebar" aria-label="Concept metadata">
        <section class="side-card">
          <div class="side-card-header">
            <span>Concrete Patterns</span>
          </div>
          <div class="pattern-links">
            {
              concept.data.relatedPatterns.map((id, index) => {
                const pattern = patternById.get(id);
                return pattern ? (
                  <a href={patternHref(pattern)}>
                    <span>PATTERN_{String(index + 1).padStart(2, '0')}</span>
                    <strong>{pattern.data.title}</strong>
                  </a>
                ) : null;
              })
            }
          </div>
        </section>

        <section class="side-card">
          <div class="side-card-header">
            <span>Metric Impact</span>
          </div>
          <ul class="metric-list">
            {
              conceptMetrics.map((metric, index) => (
                <li>
                  <span>{metric}</span>
                  <strong>{index === 2 ? 'Tighter' : 'Reduced'}</strong>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </article>

    <section class="concept-card related-card" id="patterns">
      <p class="eyebrow">Apply this through</p>
      <h2>Related Patterns</h2>
      <div class="related-grid">
        {
          concept.data.relatedPatterns.map((id) => {
            const pattern = patternById.get(id);
            return pattern ? (
              <a class="panel" href={patternHref(pattern)}>
                <strong>{pattern.data.title}</strong>
                <span>{pattern.data.summary}</span>
              </a>
            ) : null;
          })
        }
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .concept-layout {
    display: grid;
    gap: 2rem;
  }

  .concept-sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 1rem;
    align-items: start;
  }

  .concept-narrative {
    display: grid;
    gap: 1rem;
  }

  .concept-card {
    border: 2px solid var(--border);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
    scroll-margin-top: 90px;
  }

  .concept-card.muted {
    background: var(--surface-muted);
  }

  .concept-card h2 {
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .concept-card p {
    max-width: 820px;
  }

  .concept-card p:last-child {
    margin-bottom: 0;
  }

  .concept-sidebar {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 1rem;
  }

  .side-card {
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .side-card-header {
    border-bottom: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 0.8rem 1rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pattern-links {
    display: grid;
  }

  .pattern-links a {
    display: grid;
    gap: 0.25rem;
    border-bottom: 2px solid var(--border);
    color: inherit;
    padding: 1rem;
    text-decoration: none;
  }

  .pattern-links a:last-child {
    border-bottom: 0;
  }

  .pattern-links a:hover,
  .related-grid a:hover {
    background: var(--accent-soft);
  }

  .pattern-links span {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .metric-list {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 1rem;
  }

  .metric-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--surface-muted);
    padding-block: 0.75rem;
  }

  .metric-list li:first-child {
    padding-top: 0;
  }

  .metric-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .metric-list strong {
    border: 2px solid var(--border);
    background: var(--accent);
    color: var(--accent-text);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.45rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .example-card :global(.examples) {
    margin-top: 1rem;
  }

  .related-card {
    background: var(--surface);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-grid a {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .related-grid span {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .concept-sheet {
      grid-template-columns: 1fr;
    }

    .concept-sidebar {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .concept-sidebar,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
