---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { conceptHref } from '../../lib/catalog';

const concepts = await getCollection('concepts');
const conceptById = new Map(concepts.map((concept) => [concept.id, concept]));
const conceptGroups = [
  {
    id: 'reader-model',
    title: 'Reader Model',
    summary:
      'These concepts explain how TidySrc pages think about attention: what readers can keep in working memory, what review comments need to name, and when a compact card still needs enough prose.',
    concepts: ['cognitive-burden', 'reader-locality', 'observable-behavior', 'review-batch-size'],
  },
  {
    id: 'boundaries-and-shape',
    title: 'Boundaries and Shape',
    summary:
      'Use this group when the question is where a responsibility belongs, how far a change travels, and whether a module has one coherent reason to exist.',
    concepts: ['boundary-trust', 'coupling', 'cohesion', 'change-radius'],
  },
  {
    id: 'change-workflow',
    title: 'Change Workflow',
    summary:
      'These concepts cover the economics of changing code in small, reviewable steps: separating structure from behavior, preserving reversibility, and choosing a batch size.',
    concepts: ['structure-vs-behavior', 'reversibility', 'change-economics'],
  },
  {
    id: 'effects-state-time',
    title: 'Effects, State, and Time',
    summary:
      'Use this group when behavior depends on mutation, order, background work, context, or state transitions that are easy to imply and hard to review.',
    concepts: [
      'side-effect-visibility',
      'state-space',
      'temporal-coupling',
      'context-hygiene',
      'agent-guidance',
    ],
  },
];
---

<BaseLayout title="Concepts" description="Deeper TidySrc concepts behind the pattern catalog.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Concepts</p>
        <h1>Deeper ideas behind the concise pattern entries.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Concepts carry the explanation that would overload pattern pages: reader burden,
          behavior contracts, structure changes, and agent guidance.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell">
    <div class="concept-index">
      {
        conceptGroups.map((group) => (
          <a href={`#${group.id}`}>
            <span>{group.concepts.length}</span>
            {group.title}
          </a>
        ))
      }
    </div>
  </section>

  <section class="section-tight shell concept-groups">
    {
      conceptGroups.map((group) => {
        const groupConcepts = group.concepts
          .map((id) => conceptById.get(id))
          .filter((concept) => concept !== undefined);

        return (
          <section class="concept-group panel" id={group.id}>
            <div class="concept-group-head">
              <div>
                <p class="eyebrow">Concept group</p>
                <h2>{group.title}</h2>
              </div>
              <p>{group.summary}</p>
            </div>
            <div class="concept-card-grid">
              {groupConcepts.map((concept) => (
                <a class="concept-card" href={conceptHref(concept)}>
                  <Chips items={concept.data.tags} status={concept.data.status} />
                  <h3>{concept.data.title}</h3>
                  <p>{concept.data.summary}</p>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .concept-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .concept-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0.65rem 0.8rem;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .concept-index a:hover {
    background: var(--accent);
    color: var(--accent-text);
  }

  .concept-index span {
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .concept-index a:hover span {
    color: inherit;
  }

  .concept-groups {
    display: grid;
    gap: 1rem;
  }

  .concept-group {
    display: grid;
    gap: 0;
    padding: 0;
    scroll-margin-top: 96px;
  }

  .concept-group-head {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: 1rem;
    border-bottom: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 1rem;
  }

  .concept-group-head h2 {
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    text-transform: uppercase;
  }

  .concept-group-head p:last-child {
    color: var(--muted);
  }

  .concept-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .concept-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 220px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: var(--surface);
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .concept-card:hover {
    background: var(--accent-soft);
  }

  .concept-card h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
  }

  .concept-card p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .concept-group-head,
    .concept-card-grid {
      grid-template-columns: 1fr;
    }

    .concept-card {
      min-height: auto;
      border-right: 0;
    }
  }
</style>
