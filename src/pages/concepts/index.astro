---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { conceptHref } from '../../lib/catalog';

const concepts = await getCollection('concepts');
---

<BaseLayout title="Concepts" description="Deeper TidySrc concepts behind the pattern catalog.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Concepts</p>
        <h1>Deeper ideas behind the concise pattern entries.</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Concepts carry the teaching depth that would otherwise bloat every pattern page. Use them
          when you want the why, not just the review-comment form.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell grid grid-3">
    {
      concepts.map((concept) => (
        <a class="panel concept-card" href={conceptHref(concept)}>
          <Chips items={concept.data.tags} />
          <h2>{concept.data.title}</h2>
          <p>{concept.data.summary}</p>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .concept-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .concept-card h2 {
    font-size: 1.2rem;
  }

  .concept-card p {
    color: var(--muted);
  }
</style>
