---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { conceptHref } from '../../lib/catalog';

const concepts = await getCollection('concepts');
const conceptById = new Map(concepts.map((concept) => [concept.id, concept]));
const conceptGroups = [
  {
    id: 'reader-model',
    title: 'Reader Model',
    summary:
      'Readable code keeps the main decision, the evidence, and the review vocabulary close enough for a reader to hold at once.',
    concepts: ['cognitive-burden', 'reader-locality', 'observable-behavior', 'review-batch-size'],
  },
  {
    id: 'boundaries-and-shape',
    title: 'Boundaries and Shape',
    summary:
      'Boundaries decide where responsibility lives, how far a change travels, and whether a module still has one coherent reason to exist.',
    concepts: ['boundary-trust', 'coupling', 'cohesion', 'change-radius'],
  },
  {
    id: 'change-workflow',
    title: 'Change Workflow',
    summary:
      'Good change workflow separates movement from behavior, keeps decisions reversible, and limits each review to a shape people can reason about.',
    concepts: ['structure-vs-behavior', 'reversibility', 'change-economics'],
  },
  {
    id: 'effects-state-time',
    title: 'Effects, State, and Time',
    summary:
      'Mutation, ordering, background work, context, and state transitions need visible ownership before reviewers can trust the behavior.',
    concepts: [
      'side-effect-visibility',
      'state-space',
      'temporal-coupling',
      'context-hygiene',
      'agent-guidance',
    ],
  },
];
---

<BaseLayout title="Concepts" description="Deeper TidySrc concepts behind the pattern catalog.">
  <section class="section shell">
    <div class="page-hero">
      <div class="page-hero-main">
        <p class="eyebrow">Concepts</p>
        <h1>Source-change concepts</h1>
      </div>
      <div class="page-hero-side">
        <p class="lede">
          Recurring review feedback often comes from the same forces: reader burden, behavior
          contracts, change shape, visible effects, and context drift.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight shell">
    <div class="concept-family-head">
      <p class="eyebrow">Concept families</p>
      <h2>Concept families</h2>
      <p>
        The right fix sometimes depends on why a piece of code is hard to review, not only on what
        shape it currently has.
      </p>
    </div>
    <div class="concept-family-grid">
      {
        conceptGroups.map((group) => (
          <a class="concept-family-card" href={`#${group.id}`}>
            <span>{group.concepts.length} concepts</span>
            <strong>{group.title}</strong>
            <small>{group.summary}</small>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section-tight shell concept-groups">
    {
      conceptGroups.map((group) => {
        const groupConcepts = group.concepts
          .map((id) => conceptById.get(id))
          .filter((concept) => concept !== undefined);

        return (
          <section class="concept-group panel" id={group.id}>
            <div class="concept-group-head">
              <div class="concept-group-title">
                <p class="eyebrow">Concept group</p>
                <h2>{group.title}</h2>
              </div>
              <p>{group.summary}</p>
            </div>
            <div class="concept-card-grid">
              {groupConcepts.map((concept) => (
                <a class="concept-card" href={conceptHref(concept)}>
                  <Chips items={concept.data.tags} status={concept.data.status} />
                  <h3>{concept.data.title}</h3>
                  <p>{concept.data.summary}</p>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </section>
</BaseLayout>

<style>
  .concept-family-head {
    display: grid;
    gap: 0.5rem;
    max-width: 920px;
    margin-bottom: 1rem;
  }

  .concept-family-head h2 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    text-transform: uppercase;
  }

  .concept-family-head p:last-child {
    color: var(--muted);
  }

  .concept-family-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .concept-family-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 190px;
    border: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 1.15rem;
    text-decoration: none;
  }

  .concept-family-card:hover {
    background: var(--accent-soft);
    border-color: var(--border-strong);
  }

  .concept-family-card span {
    width: max-content;
    border: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 0.2rem 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .concept-family-card strong {
    display: block;
    font-size: 1.08rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .concept-family-card small {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .concept-groups {
    display: grid;
    gap: 1rem;
  }

  .concept-group {
    display: grid;
    gap: 0;
    padding: 0;
    scroll-margin-top: 96px;
  }

  .concept-group-head {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: 1rem;
    border-bottom: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 1rem;
  }

  .concept-group-title {
    display: grid;
    gap: 0.45rem;
  }

  .concept-group-head .eyebrow,
  .concept-group-head h2 {
    margin: 0;
  }

  .concept-group-head h2 {
    font-size: clamp(1.45rem, 2.5vw, 2.2rem);
    text-transform: uppercase;
  }

  .concept-group-head p:last-child {
    align-self: center;
    color: var(--muted);
    margin: 0;
  }

  .concept-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .concept-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 220px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: var(--surface);
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .concept-card:hover {
    background: var(--accent-soft);
  }

  .concept-card h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
  }

  .concept-card p {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .concept-family-grid,
    .concept-group-head,
    .concept-card-grid {
      grid-template-columns: 1fr;
    }

    .concept-card {
      min-height: auto;
      border-right: 0;
    }
  }
</style>
