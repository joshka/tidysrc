---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import CodeExamples from '../../components/CodeExamples.astro';
import CopyBox from '../../components/CopyBox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  conceptHref,
  languageLabel,
  patternHref,
  problemHref,
  sortedLanguageCodes,
} from '../../lib/catalog';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((pattern) => ({ params: { id: pattern.id }, props: { pattern } }));
}

const { pattern } = Astro.props;
const patterns = await getCollection('patterns');
const problems = await getCollection('problems');
const patternById = new Map(patterns.map((entry) => [entry.id, entry]));
const relatedProblems = problems.filter((problem) =>
  problem.data.relatedPatterns.includes(pattern.id),
);
const referenceTargets = [
  ['Tidy First', 'https://www.oreilly.com/library/view/tidy-first/9781098151232/'],
  ['Working Effectively with Legacy Code', 'https://objectmentor.com/resources/bookstore/books/welc/'],
  ['Parse, Don’t Validate', 'https://lexi-lambda.github.io/blog/2019/11/05/parse-don-t-validate/'],
  ['Agent guidance', '/concepts/agent-guidance/'],
  ['Ed Page’s Rust Style', 'https://epage.github.io/dev/rust-style/'],
] as const;
const referenceHref = (reference: string) =>
  referenceTargets.find(([label]) => reference.startsWith(label))?.[1];
const isExternalReference = (href: string) => href.startsWith('http');
const reviewProblem = pattern.data.problems[0] ?? relatedProblems[0]?.data.summary ?? pattern.data.summary;
const reviewMove = pattern.data.guidance[0] ?? pattern.data.summary;
const reviewMarkdownSnippet = [
  `Consider [${pattern.data.title}](__CURRENT_PAGE_URL__): ${reviewProblem}`,
  '',
  `Suggested move: ${reviewMove}`,
].join('\n');
const languageChoices = sortedLanguageCodes(pattern.data.languages);
const languageChoiceLabels = languageChoices.map(languageLabel);
---

<BaseLayout title={pattern.data.title} description={pattern.data.summary}>
  <section class="section shell">
    <div class="pattern-hero">
      <div class="hero-title">
        <p class="eyebrow">Pattern // {pattern.id}</p>
        <h1>{pattern.data.title}</h1>
        <Chips
          items={[...pattern.data.tags.slice(0, 3), ...languageChoiceLabels]}
          status={pattern.data.status}
        />
      </div>
      <blockquote>{pattern.data.summary}</blockquote>
    </div>
  </section>

  <section class="section-tight shell">
    <article class="article">
      <section class="narrative-card" id="narrative">
        <h2>Core Idea</h2>
        <p>{pattern.data.narrative}</p>
      </section>

      <div class="bento-grid">
        <section class="bento-card" id="use-when">
          <h2>Use When</h2>
          <ul>
            {pattern.data.useWhen.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="bento-card muted" id="guidance">
          <h2>Guidance</h2>
          <ul>
            {pattern.data.guidance.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="bento-card" id="tradeoffs">
          <h2>Tradeoffs</h2>
          <ul>
            {pattern.data.tradeoffs.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>

      <section id="examples">
        <div class="section-bar">
          <h2>Implementation</h2>
          <span>{languageChoiceLabels.join(' / ')}</span>
        </div>
        <div class="implementation-tabs">
          <CodeExamples examples={pattern.data.examples} />
        </div>
      </section>

      <section class="agent-panel" id="agents">
        <div class="agent-mark">Agent Instruction</div>
        <CopyBox text={pattern.data.agentInstruction} />
      </section>

      <section class="agent-panel review-snippet" id="review-snippet">
        <div class="agent-mark">Review Snippet</div>
        <CopyBox
          resolveCurrentUrl
          text={reviewMarkdownSnippet}
        />
      </section>

      <section id="related">
        <h2 class="underlined">Related</h2>
        <div class="related-grid">
          {
            relatedProblems.map((problem) => (
              <a class="panel problem-link" href={problemHref(problem)}>
                <strong>Problem: {problem.data.title}</strong>
                <span>{problem.data.summary}</span>
              </a>
            ))
          }
          {
            pattern.data.related.map((id) => {
              const related = patternById.get(id);
              return related ? (
                <a class="panel" href={patternHref(related)}>
                  <strong>{related.data.title}</strong>
                  <span>{related.data.summary}</span>
                </a>
              ) : null;
            })
          }
          {
            pattern.data.concepts.map((id) => (
              <a class="panel" href={conceptHref(id)}>
                <strong>Concept: {id.replaceAll('-', ' ')}</strong>
                <span>Read the deeper idea behind this pattern.</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="references">
        <h2 class="underlined">References</h2>
        <ul class="reference-list">
          {
            pattern.data.references.map((reference) => {
              const href = referenceHref(reference);
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      rel={isExternalReference(href) ? 'noreferrer' : undefined}
                      target={isExternalReference(href) ? '_blank' : undefined}
                    >
                      {reference}
                    </a>
                  ) : (
                    <span>{reference}</span>
                  )}
                </li>
              );
            })
          }
        </ul>
      </section>
    </article>
  </section>
</BaseLayout>

<style>
  .pattern-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .hero-title {
    display: grid;
    gap: 1rem;
    border-right: 2px solid var(--border);
    background: var(--surface-strong);
    color: var(--strong-text);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-title .eyebrow {
    color: var(--accent);
  }

  .hero-title h1 {
    color: var(--strong-text);
    font-size: clamp(2.4rem, 6vw, 5rem);
    text-transform: uppercase;
  }

  .pattern-hero blockquote {
    align-self: center;
    border-left: 4px solid var(--accent);
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-style: italic;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .article {
    display: grid;
    gap: 2rem;
  }

  .article section {
    scroll-margin-top: 90px;
  }

  .article ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .article li + li {
    margin-top: 0.45rem;
  }

  .narrative-card {
    border: 2px solid var(--border);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .narrative-card h2 {
    border-bottom: 2px solid var(--border);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .narrative-card p:last-child {
    max-width: 900px;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    margin-bottom: 0;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .bento-card {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .bento-card + .bento-card {
    border-left: 2px solid var(--border);
  }

  .bento-card.muted {
    background: var(--surface-muted);
  }

  .bento-card h2,
  .section-bar h2,
  .underlined {
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .section-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 2px solid var(--border);
    border-bottom: 0;
    background: var(--surface-muted);
    padding: 1rem 1.25rem;
  }

  .section-bar h2 {
    margin: 0;
    border-bottom: 0;
    padding: 0;
  }

  .section-bar span {
    font-weight: 800;
    text-transform: uppercase;
  }

  .implementation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    border: 2px solid var(--border);
    background: var(--surface);
    min-width: 0;
    padding: 1rem;
  }

  .implementation-panel {
    border: 2px solid var(--border);
    background: var(--surface);
    min-width: 0;
  }

  .implementation-panel.after {
    background: var(--surface-strong);
    color: var(--strong-text);
  }

  .code-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .implementation-panel :global(.examples) {
    padding: 1rem;
  }

  .supplemental-examples {
    border: 2px solid var(--border);
    background: var(--surface);
    margin-top: 1rem;
    min-width: 0;
    padding: 1rem;
  }

  .implementation-tabs {
    border: 2px solid var(--border);
    background: var(--surface);
    min-width: 0;
    padding: 1rem;
  }

  .agent-panel {
    display: grid;
    grid-template-columns: minmax(220px, 0.28fr) minmax(0, 1fr);
    border: 2px solid var(--border);
    background: var(--surface);
  }

  .agent-mark {
    display: grid;
    place-items: center;
    border-right: 2px solid var(--border);
    background: var(--surface-strong);
    color: var(--accent);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.45;
    padding: 1.5rem;
    text-align: center;
    text-transform: uppercase;
  }

  .agent-panel :global(.copy-box) {
    border: 0;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .review-snippet :global(.copy-box) {
    white-space: pre-wrap;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-grid a {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .related-grid span {
    color: var(--muted);
  }

  .reference-list a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .reference-list span {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .pattern-hero,
    .bento-grid,
    .agent-panel,
    .review-snippet,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .hero-title,
    .bento-card + .bento-card,
    .agent-mark,
    .review-snippet .agent-mark {
      border-right: 0;
      border-left: 0;
    }

    .bento-card + .bento-card,
    .agent-mark,
    .review-snippet :global(.copy-box) {
      border-top: 2px solid var(--border);
    }
  }

  @media (max-width: 1120px) {
    .implementation-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
