---
import { getCollection } from 'astro:content';

import Chips from '../../components/Chips.astro';
import CodeExamples from '../../components/CodeExamples.astro';
import CopyBox from '../../components/CopyBox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { conceptHref, patternHref } from '../../lib/catalog';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((pattern) => ({ params: { id: pattern.id }, props: { pattern } }));
}

const { pattern } = Astro.props;
const patterns = await getCollection('patterns');
const patternById = new Map(patterns.map((entry) => [entry.id, entry]));
---

<BaseLayout title={pattern.data.title} description={pattern.data.summary}>
  <section class="section narrow">
    <p class="eyebrow">Pattern</p>
    <h1>{pattern.data.title}</h1>
    <p class="lede">{pattern.data.summary}</p>
    <Chips
      items={[...pattern.data.tags, ...pattern.data.audiences, ...pattern.data.languages]}
      status={pattern.data.status}
    />
  </section>

  <section class="section-tight shell page-grid">
    <article class="article">
      <section id="use-when">
        <h2>Use When</h2>
        <ul>
          {pattern.data.useWhen.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="guidance">
        <h2>Guidance</h2>
        <ul>
          {pattern.data.guidance.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="tradeoffs">
        <h2>Tradeoffs</h2>
        <ul>
          {pattern.data.tradeoffs.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section id="examples">
        <h2>Examples</h2>
        <CodeExamples examples={pattern.data.examples} />
      </section>

      <section id="agents">
        <h2>For Agents</h2>
        <CopyBox label="Copyable agent instruction" text={pattern.data.agentInstruction} />
      </section>

      <section id="related">
        <h2>Related</h2>
        <div class="related-grid">
          {
            pattern.data.related.map((id) => {
              const related = patternById.get(id);
              return related ? (
                <a class="panel" href={patternHref(related)}>
                  <strong>{related.data.title}</strong>
                  <span>{related.data.summary}</span>
                </a>
              ) : null;
            })
          }
          {
            pattern.data.concepts.map((id) => (
              <a class="panel" href={conceptHref(id)}>
                <strong>Concept: {id.replaceAll('-', ' ')}</strong>
                <span>Read the deeper idea behind this pattern.</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="references">
        <h2>References</h2>
        <ul>
          {pattern.data.references.map((reference) => <li>{reference}</li>)}
        </ul>
      </section>
    </article>

    <nav class="toc" aria-label="On this page">
      <a href="#use-when">Use When</a>
      <a href="#guidance">Guidance</a>
      <a href="#tradeoffs">Tradeoffs</a>
      <a href="#examples">Examples</a>
      <a href="#agents">For Agents</a>
      <a href="#related">Related</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: 2rem;
    max-width: 820px;
  }

  .article section {
    scroll-margin-top: 90px;
  }

  .article ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .article li + li {
    margin-top: 0.45rem;
  }

  .related-grid {
    display: grid;
    gap: 0.75rem;
  }

  .related-grid a {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .related-grid span {
    color: var(--muted);
  }
</style>

