---
import { getCollection } from 'astro:content';

import PatternList from '../../components/PatternList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allLanguages, allTags, languageLabel } from '../../lib/catalog';

const patterns = await getCollection('patterns');
const tags = allTags(patterns);
const languages = allLanguages(patterns);
const pathways = [
  {
    title: 'Readability and Local Shape',
    tag: 'readability',
    summary:
      'Use these when the code works, but the next reader has to hold too many jumps, names, branches, or hidden facts at once.',
  },
  {
    title: 'Boundaries and Contracts',
    tag: 'boundaries',
    summary:
      'Use these when raw data, configuration, errors, or layer vocabulary crosses farther than it should.',
  },
  {
    title: 'Testing and Verification',
    tag: 'testing',
    summary:
      'Use these when the question is what behavior is protected and which check is trustworthy enough for the change.',
  },
  {
    title: 'Workflow and Review',
    tag: 'workflow',
    summary:
      'Use these when the risk is in change shape: batching, structure versus behavior, reversibility, or agent handoff.',
  },
  {
    title: 'State, Effects, and Async',
    tag: 'side-effects',
    summary:
      'Use these when mutation, time, background work, failure, or state transitions need to become visible.',
  },
  {
    title: 'Agent-Resistant Defaults',
    tag: 'agent-guidance',
    summary:
      'Use these when a human or coding agent is likely to overbuild, drift from local rules, or keep patching without evidence.',
  },
];
---

<BaseLayout title="Patterns" description="Searchable TidySrc pattern catalog.">
  <section class="section shell">
    <p class="eyebrow">Pattern catalog</p>
    <h1>Short, addressable patterns for source change.</h1>
    <p class="lede">
      Search by pattern name, problem, tag, audience, or language. Each entry gives reviewers and
      agents a shared name, a concrete trigger, and implementation examples.
    </p>
  </section>

  <section class="section-tight shell">
    <div class="pathway-head">
      <p class="eyebrow">Choose an entry point</p>
      <h2>Start with the kind of change pressure you see.</h2>
      <p>
        These are not separate catalogs. They are review paths through the same pattern language, so
        a problem can move from readability to verification or boundaries as the evidence sharpens.
      </p>
    </div>
    <div class="pathway-grid" role="tablist" aria-label="Pattern pathways">
      {
        pathways.map((pathway) => (
          <button
            class="pathway-card"
            type="button"
            data-quick-filter="tags"
            data-value={pathway.tag}
          >
            <span>{pathway.tag}</span>
            <strong>{pathway.title}</strong>
            <small>{pathway.summary}</small>
          </button>
        ))
      }
    </div>
  </section>

  <section class="section-tight shell catalog-layout">
    <aside class="filters panel" aria-label="Pattern filters">
      <label>
        Search
        <input data-catalog-search type="search" placeholder="legacy tests, guard, Rust" />
      </label>

      <label>
        Status
        <select data-catalog-filter="status">
          <option value="">Any status</option>
          <option value="stable">Stable</option>
          <option value="draft">Draft</option>
          <option value="seed">Seed</option>
        </select>
      </label>

      <label>
        Tag
        <select data-catalog-filter="tags">
          <option value="">Any tag</option>
          {tags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
      </label>

      <label>
        Language
        <select data-catalog-filter="languages">
          <option value="">Any language</option>
          {languages.map((language) => <option value={language}>{languageLabel(language)}</option>)}
        </select>
      </label>

      <label>
        Audience
        <select data-catalog-filter="audiences">
          <option value="">Any audience</option>
          <option value="reviewers">Reviewers</option>
          <option value="agents">Agents</option>
          <option value="learners">Learners</option>
        </select>
      </label>
    </aside>

    <PatternList patterns={patterns} />
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-catalog-search]');
  const filters = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-catalog-filter]'));
  const quickFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-pattern-row]'));
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const params = new URLSearchParams(window.location.search);

  if (search && params.has('q')) {
    search.value = params.get('q') ?? '';
  }

  for (const filter of filters) {
    const key = filter.dataset.catalogFilter;
    if (key && params.has(key)) {
      filter.value = params.get(key) ?? '';
    }
  }

  function updateUrl() {
    const next = new URLSearchParams();
    const query = search?.value.trim() ?? '';
    if (query) {
      next.set('q', query);
    }

    for (const filter of filters) {
      const key = filter.dataset.catalogFilter;
      if (key && filter.value) {
        next.set(key, filter.value);
      }
    }

    const queryString = next.toString();
    const url = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    window.history.replaceState(null, '', url);
  }

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;

    for (const row of rows) {
      const matchesQuery = !query || row.dataset.search?.includes(query);
      const matchesFilters = filters.every((filter) => {
        const value = filter.value;
        const key = filter.dataset.catalogFilter;
        return !value || row.dataset[key ?? '']?.split(' ').includes(value);
      });

      const show = Boolean(matchesQuery && matchesFilters);
      row.hidden = !show;
      if (show) {
        visible += 1;
      }
    }

    if (empty) {
      empty.hidden = visible > 0;
    }

    updateUrl();
  }

  search?.addEventListener('input', applyFilters);
  for (const filter of filters) {
    filter.addEventListener('change', applyFilters);
  }
  for (const quickFilter of quickFilters) {
    quickFilter.addEventListener('click', () => {
      const key = quickFilter.dataset.quickFilter;
      const value = quickFilter.dataset.value ?? '';
      const target = filters.find((filter) => filter.dataset.catalogFilter === key);
      if (target) {
        target.value = target.value === value ? '' : value;
      }
      applyFilters();
    });
  }
  applyFilters();
</script>

<style>
  .pathway-head {
    display: grid;
    gap: 0.5rem;
    max-width: 920px;
    margin-bottom: 1rem;
  }

  .pathway-head h2 {
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    text-transform: uppercase;
  }

  .pathway-head p:last-child {
    color: var(--muted);
  }

  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pathway-card {
    display: grid;
    gap: 0.6rem;
    min-height: 190px;
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    padding: 1rem;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pathway-card:hover,
  .pathway-card:focus-visible {
    background: var(--accent-soft);
    border-color: var(--border-strong);
  }

  .pathway-card span {
    width: max-content;
    border: 2px solid var(--border);
    background: var(--surface-muted);
    padding: 0.2rem 0.35rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pathway-card strong {
    font-size: 1.08rem;
    text-transform: uppercase;
  }

  .pathway-card small {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .catalog-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .filters {
    position: sticky;
    top: 88px;
    display: grid;
    gap: 0.85rem;
  }

  .filters label {
    display: grid;
    gap: 0.3rem;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filters input,
  .filters select {
    width: 100%;
    border: 2px solid var(--border-strong);
    border-radius: 0;
    padding: 0.55rem 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  @media (max-width: 820px) {
    .pathway-grid,
    .catalog-layout {
      grid-template-columns: 1fr;
    }

    .filters {
      position: static;
    }
  }
</style>
