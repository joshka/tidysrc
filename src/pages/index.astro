---
import { getCollection } from 'astro:content';

import Chips from '../components/Chips.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { conceptHref, patternHref, problemHref, sortedProblems } from '../lib/catalog';
import { sitePath } from '../lib/site';

const patterns = await getCollection('patterns');
const concepts = await getCollection('concepts');
const problems = sortedProblems(await getCollection('problems'));
const representativeProblemIds = [
  'hidden-main-path',
  'tests-freeze-private-shape',
  'premature-architecture',
];
const representativePatternIds = [
  'guard-clause',
  'test-observable-behavior',
  'reader-locality',
];
const representativeConceptIds = ['cognitive-burden', 'change-radius', 'observable-behavior'];
const byId = <T extends { id: string }>(entries: T[]) =>
  new Map(entries.map((entry) => [entry.id, entry]));
const entriesById = <T extends { id: string }>(entries: T[], ids: string[]) => {
  const lookup = byId(entries);
  return ids.map((id) => lookup.get(id)).filter((entry): entry is T => entry !== undefined);
};
const representativeProblems = entriesById(problems, representativeProblemIds);
const representativePatterns = entriesById(patterns, representativePatternIds);
const representativeConcepts = entriesById(concepts, representativeConceptIds);
---

<BaseLayout title="TidySrc">
  <section class="section shell hero">
    <div class="hero-panel">
      <p class="eyebrow">Pattern language for everyday source change</p>
      <h1>TidySrc is a pattern language for making source code easier to change.</h1>
      <p class="lede">
        Paste a canonical link into review when a source-change problem needs a shared name. The
        page gives reviewers and coding agents the same vocabulary for the risk, the pattern, and
        the fix.
      </p>
      <form class="hero-search" action={sitePath('/search/')}>
        <label for="home-search">Search TidySrc</label>
        <div>
          <input
            id="home-search"
            name="q"
            type="search"
            placeholder="hidden main path, guard clause, observable behavior"
          />
          <button class="button primary" type="submit">Search</button>
        </div>
      </form>
    </div>
  </section>

  <section class="section-tight shell grid grid-3 primary-grid" aria-label="Primary sections">
    <a class="panel nav-panel" href={sitePath('/problems/')}>
      <strong>Problems</strong>
      <span>Diagnose the source-change smell before choosing the pattern.</span>
    </a>
    <a class="panel nav-panel" href={sitePath('/patterns/')}>
      <strong>Patterns</strong>
      <span>Short, linkable entries for review and implementation.</span>
    </a>
    <a class="panel nav-panel" href={sitePath('/concepts/')}>
      <strong>Concepts</strong>
      <span>Deeper ideas that repeat across several patterns.</span>
    </a>
    <a class="panel nav-panel" href={sitePath('/agents/')}>
      <strong>Agents</strong>
      <span>Copyable operating guidance for coding agents.</span>
    </a>
    <a class="panel nav-panel" href={sitePath('/references/')}>
      <strong>References</strong>
      <span>Influences, catalogs, and prior art behind the pattern language.</span>
    </a>
    <a class="panel nav-panel" href="#why-this-exists">
      <strong>Why TidySrc</strong>
      <span>The repeated review feedback this site turns into shared language.</span>
    </a>
  </section>

  <section class="section-tight shell" id="why-this-exists">
    <div class="panel why-band">
      <div>
        <p class="eyebrow">Why this exists</p>
        <h2>Repeated review feedback should become shared language.</h2>
      </div>
      <div>
        <p>
          The same comments come up again and again: the main path is buried, tests freeze private
          shape, an abstraction arrived before the second example, or a rule is scattered across too
          many files.
        </p>
        <p>
          Some of that feedback can become automated checks. The rest is judgment about reader
          burden, change radius, behavior contracts, and tradeoffs. TidySrc turns those recurring
          source-change concerns into linkable problems and patterns.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">Problem index</p>
        <h2>Find the review comment you keep rewriting.</h2>
        <p>
          These examples are deliberately ordinary: hard-to-find main logic, brittle tests, and
          architecture added before the code earns it.
        </p>
      </div>
      <a class="button" href={sitePath('/problems/')}>Browse all {problems.length}</a>
    </div>
    <div class="grid grid-3 feature-grid">
      {
        representativeProblems.map((problem) => (
          <a class="panel feature" href={problemHref(problem)}>
            <p class="eyebrow">Problem</p>
            <h3>{problem.data.title}</h3>
            <p>{problem.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">Featured patterns</p>
        <h2>Practical patterns for improving code.</h2>
        <p>
          The first patterns should handle common review feedback without requiring a new framework:
          flatten the path, protect behavior, and keep related ideas close.
        </p>
      </div>
      <a class="button" href={sitePath('/patterns/')}>Browse all {patterns.length}</a>
    </div>
    <div class="grid grid-3 feature-grid">
      {
        representativePatterns.map((pattern) => (
          <a class="panel feature" href={patternHref(pattern)}>
            <Chips items={pattern.data.tags.slice(0, 2)} status={pattern.data.status} />
            <h3>{pattern.data.title}</h3>
            <p>{pattern.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">Concept anchors</p>
        <h2>Core ideas behind maintainable source changes.</h2>
        <p>
          Repeated comments often point to the same pressures: limited reader attention, change
          radius, and behavior that tests should protect.
        </p>
      </div>
    </div>
    <div class="grid grid-3">
      {
        representativeConcepts.map((concept) => (
          <a class="panel feature" href={conceptHref(concept)}>
            <h3>{concept.data.title}</h3>
            <p>{concept.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: 72px 40px;
  }

  .hero-panel {
    border: 2px solid var(--border);
    background: var(--surface);
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .hero h1 {
    max-width: 900px;
    text-transform: uppercase;
  }

  .hero-search {
    display: grid;
    gap: 0.5rem;
    max-width: 680px;
    margin-top: 2rem;
  }

  .hero-search label {
    font-weight: 700;
  }

  .hero-search div {
    display: flex;
    gap: 0.5rem;
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    border: 2px solid var(--border-strong);
    border-radius: 0;
    padding: 0.7rem 0.8rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
  }

  .nav-panel,
  .feature {
    color: inherit;
    text-decoration: none;
  }

  .nav-panel {
    display: grid;
    gap: 0.35rem;
    min-height: 190px;
  }

  .nav-panel strong,
  .feature h3 {
    text-transform: uppercase;
  }

  .nav-panel span,
  .feature p {
    color: var(--muted);
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-head p:last-child {
    color: var(--muted);
    margin: 0.45rem 0 0;
    max-width: 760px;
  }

  .feature {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 190px;
  }

  .why-band {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: 1.5rem;
    background: var(--surface-muted);
  }

  .why-band h2 {
    margin-bottom: 0;
    text-transform: uppercase;
  }

  .why-band p:last-child {
    margin-bottom: 0;
  }

  .problem-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
  }

  .problem-entry p:last-child {
    margin-bottom: 0;
  }

  .support-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    border: 2px solid var(--border);
    background: var(--surface-muted);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .support-panel h2 {
    max-width: 860px;
    text-transform: uppercase;
  }

  .support-panel p:last-child {
    color: var(--muted);
    margin-bottom: 0;
    max-width: 720px;
  }

  @media (max-width: 720px) {
    .hero-search div,
    .section-head,
    .why-band,
    .support-panel {
      align-items: stretch;
      flex-direction: column;
    }

    .why-band,
    .support-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
